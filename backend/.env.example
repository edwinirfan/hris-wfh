# ---------- Shared ----------
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_LOGGING=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672
SEED_DEMO_DATA=true
# Wajib sama di auth-service (sign) dan api-gateway (verify); min 32 karakter
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars

# ---------- auth-service ----------
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=4001
AUTH_DB_NAME=hris_auth_db
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------- employee-service ----------
EMPLOYEE_SERVICE_HOST=localhost
EMPLOYEE_SERVICE_PORT=4002
EMPLOYEE_DB_NAME=hris_employee_db

# ---------- attendance-service ----------
ATTENDANCE_SERVICE_HOST=localhost
ATTENDANCE_SERVICE_PORT=4003
ATTENDANCE_DB_NAME=hris_attendance_db

# ---------- api-gateway ----------
GATEWAY_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
FILE_URL_SECRET=change-me-to-another-long-random-string
FILE_URL_TTL_SECONDS=300
# local | s3 (S3-compatible: RustFS, MinIO, AWS S3, dsb.)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=localhost
S3_PORT=9100
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=attendance-photos
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60
